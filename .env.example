# Copy to .env for local testing (npm run dev). Never commit .env.
# In production set these in Vercel → Project → Settings → Environment Variables.

# Output of `npm run hash-password`
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (also printed by `npm run hash-password`)
SESSION_SECRET=

# GitHub fine-grained token: only this repository, permission "Contents: Read and write"
GITHUB_TOKEN=
GITHUB_REPO=olympbadm-tech/Kyiv-Badminton-Olymp
GITHUB_BRANCH=main

# Added automatically when a Blob store is connected to the Vercel project
BLOB_READ_WRITE_TOKEN=

# Local development only: save to content/site.json on disk instead of GitHub.
# Ignored on Vercel.
# CONTENT_STORE=local
